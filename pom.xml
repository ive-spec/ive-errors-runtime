<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ive.spec</groupId>
	<artifactId>ive-errors-runtime</artifactId>
	<version>1.0.9</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
			The tests' JUnit and surefire, pinned through the parent's own
			properties: the parent manages JUnit 6 and surefire 3.5 through
			a BOM, and pinning only the dependency would mix a 5.x Jupiter
			with a 6.x platform. Same versions as ive-data-protection.
		-->
		<junit-jupiter.version>5.10.2</junit-jupiter.version>
		<maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
	</properties>
	<!--
		SIN DEPENDENCIAS, A PROPOSITO.

		Las 17 clases de esta libreria son POJOs: ninguna importa
		`org.springframework`. Tenia `spring-boot-starter-webmvc`, y eso
		lo heredaba TODO SDK generado, que no tiene por que arrastrar el
		stack web para declarar sus errores de negocio.

		Del parent se sigue heredando, pero solo por la gestion de
		versiones y la configuracion del compilador.
	-->
	<dependencies>
		<!--
			Jackson y nada mas. `fromBody` tiene que LEER el cuerpo
			`DetailedErrorView` que devuelve el servidor: sin parsearlo,
			todo lo que dice sobre que campo fallo llega como un String
			suelto. La version la maneja el parent.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!-- Test only: the guide, the body writer and the reader (src/test). -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
		      <plugin>
		        <groupId>org.apache.maven.plugins</groupId>
		        <artifactId>maven-jar-plugin</artifactId>
		        <version>3.4.2</version>
		      </plugin>			
		</plugins>
	</build>

</project>
